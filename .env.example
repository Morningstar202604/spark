# ─── Spark Environment Configuration ──────────────────────────────────
# Copy this to $SPARK_HOME/.env (default ~/.spark/.env) and adjust.
# NOTE: Spark reads .env ONLY from $SPARK_HOME/.env, never from a project
# directory — a cloned repo cannot hand itself full-auto permissions.
# Do NOT commit the filled-in file to version control.
#
# Nested fields use double-underscore: SPARK_AGENT__MAX_TOOL_ROUNDS=50

# ─── Provider ─────────────────────────────────────────────────────────
# OpenAI-compatible endpoint + model + key (all three go under [provider]):
SPARK_PROVIDER__BASE_URL=https://api.deepseek.com/v1
SPARK_PROVIDER__MODEL=deepseek-chat
# Paste your key here (this example file must stay keyless):
# SPARK_PROVIDER__API_KEY=
# Alternative: point at an env var that already holds the key
# SPARK_PROVIDER__API_KEY_ENV=DEEPSEEK_API_KEY

# ─── Agent Behavior ────────────────────────────────────────────────────
# SPARK_AGENT__APPROVAL=suggest            # suggest | auto-edit | full-auto
# SPARK_AGENT__SANDBOX_MODE=workspace      # sandbox-only | workspace | full-access | unrestricted
# SPARK_AGENT__SHELL_TIMEOUT_SEC=60
# SPARK_AGENT__MAX_TOOL_ROUNDS=30
# SPARK_AGENT__MAX_OUTPUT_CHARS=8000
# SPARK_AGENT__WORKDIR_ONLY=true

# ─── Context Window ────────────────────────────────────────────────────
# SPARK_CONTEXT__MAX_CONTEXT_TOKENS=32768
# SPARK_CONTEXT__COMPACT_THRESHOLD=0.85
# SPARK_CONTEXT__KEEP_RECENT_MESSAGES=8

# ─── Memory ────────────────────────────────────────────────────────────
# SPARK_MEMORY__ENABLED=true
# SPARK_MEMORY__TOP_K=6
# SPARK_MEMORY__AUTO_EXTRACT=true

# ─── System ────────────────────────────────────────────────────────────
# 配置文件位置：由 SPARK_HOME 决定（默认 ~/.spark/config.toml）；CLI 可用 --config 覆盖。
# SPARK_HOME=/path/to/.spark        # 数据目录（配置/会话/记忆/检查点都存这里）
# LITELLM_LOCAL_MODEL_COST_MAP=True # Use LiteLLM's bundled model prices (skip
                                    # the raw.githubusercontent.com fetch — the
                                    # default fetch fails in mainland China and
                                    # costs ~9s of retries on every import)
