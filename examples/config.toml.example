# Spark 配置示例 —— 复制为 ~/.spark/config.toml 后按需修改
# 完整字段说明见 docs/CONFIG.md；模板由 `spark init` 自动生成。
# 字段的唯一事实来源：src/spark/config.py

[provider]
name = "openai_compat"                 # openai_compat / ollama / mock
base_url = "https://api.deepseek.com/v1"  # 任意 OpenAI 兼容端点（LiteLLM 承载）
model = "deepseek-chat"
# api_key 行存在但示例保持无密钥：把密钥写进你本地的配置或 SPARK_API_KEY 环境变量
api_key_env = "SPARK_API_KEY"

[agent]
approval = "suggest"                   # suggest / auto-edit / full-auto
workdir_only = true
sandbox_mode = "workspace"             # sandbox-only / workspace / full-access / unrestricted
shell_timeout_sec = 60
max_tool_rounds = 30
max_repeat_calls = 4                   # 同参数重复调用熔断；0 = 关闭
max_turn_tokens = 0                    # 单回合 token 预算；0 = 关闭
max_output_chars = 8000

[context]
agents_md = "AGENTS.md"
max_fragment_chars = 8000
history_budget_chars = 96000
max_context_tokens = 32768
compact_threshold = 0.85               # 上下文用量超过此比例自动压缩
keep_recent_messages = 8

[memory]
enabled = true                         # ChromaDB 向量 + 关键词检索
top_k = 6
capacity = 500
embedding_model = "text-embedding-3-small"
auto_extract = true

# ---- MCP 服务器（取消注释即启用，需本地已装对应命令）----
# 常用 MCP server 预设（国内可用优先）：
#
# [[mcp_servers]]
# name = "filesystem"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "."]
# readonly_tools = []                  # 声明为只读的工具名（免审批）
#
# [[mcp_servers]]
# name = "fetch"                       # 网页抓取（读 URL 内容）
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-fetch"]
#
# [[mcp_servers]]
# name = "git"                         # Git 操作
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-git", "."]
#
# [[mcp_servers]]
# name = "time"                        # 时间/时区工具
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-time"]
#
# [[mcp_servers]]
# name = "memory"                      # 持久化记忆
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-memory"]
#
# [[mcp_servers]]
# name = "playwright"                  # 浏览器自动化（需本地有 Chromium）
# command = "npx"
# args = ["-y", "@playwright/mcp@latest"]
#
# 远程传输：
# [[mcp_servers]]
# name = "remote"
# transport = "sse"                    # stdio | sse | streamable_http
# [mcp_servers.http]
# url = "http://127.0.0.1:3000/sse"

# ---- 生命周期钩子 ----
# [[hooks]]
# event = "pre_tool"
# command = "python"
# args = ["check.py"]
# timeout_sec = 15
# on_deny = "warn"                     # warn | block

# ---- 多模型 profiles（网页设置 → 模型 读写这一节）----
# active_profile_id = "a1b2c3d4"
# [[model_profiles]]
# id = "a1b2c3d4"
# name = "DeepSeek"
# provider = "openai_compat"
# base_url = "https://api.deepseek.com/v1"
# model = "deepseek-chat"
# api_key 字段留空则回退 [provider] 的密钥

# ---- 环境变量覆盖（双下划线嵌套）----
#   SPARK_AGENT__MAX_TOOL_ROUNDS=50
#   SPARK_PROVIDER__BASE_URL=https://api.deepseek.com/v1
# 注意：.env 只从 ~/.spark/.env 读取，项目目录内的 .env 会被忽略（防克隆仓库提权）
