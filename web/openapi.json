{
  "openapi": "3.1.0",
  "info": {
    "title": "Spark Web API",
    "description": "Spark 本地 Web 服务合同层。运行时由本地 token 鉴权；此 schema 供前端 codegen（orval/openapi-typescript）与未来 FastAPI 迁移复用。",
    "version": "0.9"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "runtime"
        ],
        "summary": "运行态快照（会话/循环/用量）",
        "operationId": "_get_status_api_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "runtime"
        ],
        "summary": "完整配置（已脱敏）",
        "operationId": "_get_config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response  Get Config Api Config Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "模型档案列表（密钥脱敏）",
        "operationId": "_get_models_api_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/memory": {
      "get": {
        "tags": [
          "memory"
        ],
        "summary": "记忆条目 + 可选搜索",
        "operationId": "_get_memory_api_memory_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "当前 workdir 的会话列表（≤50）",
        "operationId": "_get_sessions_api_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/checkpoints": {
      "get": {
        "tags": [
          "checkpoints"
        ],
        "summary": "当前会话检查点",
        "operationId": "_get_checkpoints_api_checkpoints_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckpointsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "当前会话消息历史",
        "operationId": "_get_history_api_history_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response  Get History Api History Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/search": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "会话全文检索（FTS5 trigram；命中消息正文时带片段）",
        "operationId": "_get_session_search_api_sessions_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckpointRow": {
        "properties": {},
        "additionalProperties": true,
        "type": "object",
        "title": "CheckpointRow"
      },
      "CheckpointsResponse": {
        "properties": {
          "checkpoints": {
            "items": {
              "$ref": "#/components/schemas/CheckpointRow"
            },
            "type": "array",
            "title": "Checkpoints"
          }
        },
        "type": "object",
        "required": [
          "checkpoints"
        ],
        "title": "CheckpointsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "id",
          "content"
        ],
        "title": "MemoryItem"
      },
      "MemoryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MemoryItem"
            },
            "type": "array",
            "title": "Items"
          },
          "search": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Search"
          },
          "stats": {
            "additionalProperties": true,
            "type": "object",
            "title": "Stats"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "MemoryResponse"
      },
      "ModelProfile": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "base_url": {
            "type": "string",
            "title": "Base Url"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "api_key_masked": {
            "type": "string",
            "title": "Api Key Masked",
            "default": ""
          },
          "has_api_key": {
            "type": "boolean",
            "title": "Has Api Key",
            "default": false
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "provider",
          "base_url",
          "model"
        ],
        "title": "ModelProfile"
      },
      "ModelsResponse": {
        "properties": {
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/ModelProfile"
            },
            "type": "array",
            "title": "Profiles"
          }
        },
        "type": "object",
        "required": [
          "profiles"
        ],
        "title": "ModelsResponse"
      },
      "SessionRow": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Keywords"
          },
          "workdir": {
            "type": "string",
            "title": "Workdir",
            "default": ""
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": ""
          },
          "created_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "SessionRow"
      },
      "SessionSearchHit": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "workdir": {
            "type": "string",
            "title": "Workdir"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "updated_at": {
            "type": "integer",
            "title": "Updated At"
          },
          "match": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Match"
          }
        },
        "type": "object",
        "required": [
          "id",
          "workdir",
          "title",
          "updated_at",
          "match"
        ],
        "title": "SessionSearchHit"
      },
      "SessionSearchResponse": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/SessionSearchHit"
            },
            "type": "array",
            "title": "Hits"
          }
        },
        "type": "object",
        "title": "SessionSearchResponse"
      },
      "SessionsResponse": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionRow"
            },
            "type": "array",
            "title": "Sessions"
          },
          "current": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current"
          }
        },
        "type": "object",
        "required": [
          "sessions"
        ],
        "title": "SessionsResponse"
      },
      "StatusInfo": {
        "properties": {},
        "additionalProperties": true,
        "type": "object",
        "title": "StatusInfo",
        "description": "state.status() 的运行态快照（键集以实现为准，宽松类型）。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
